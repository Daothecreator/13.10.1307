/*
 * xdp_cns_mirror.bpf.c — High-Throughput Packet Mirroring for Novation & CNS Traffic
 */

#include "vmlinux.h"
#include <bpf/bpf_helpers.h>
#include <bpf/bpf_endian.h>

#define ETH_P_IP 0x0800
#define MAX_PACKET_SLICE 512

char LICENSE[] SEC("license") = "GPL";

struct packet_mirror_t {
    __u64 timestamp_ns;
    __u32 ingress_ifindex;
    __u32 packet_len;
    __u32 src_ip;
    __u32 dst_ip;
    __u16 src_port;
    __u16 dst_port;
    __u8  protocol;
    __u8  data[MAX_PACKET_SLICE];
};

struct {
    __uint(type, BPF_MAP_TYPE_RINGBUF);
    __uint(max_entries, 64 * 1024 * 1024); /* 64MB Ingestion Pool */
} xdp_mirror_ringbuf SEC(".maps");

SEC("xdp")
int xdp_cns_mirror_prog(struct xdp_md *ctx) {
    void *data_end = (void *)(long)ctx->data_end;
    void *data = (void *)(long)ctx->data;

    struct ethhdr *eth = data;
    if ((void *)(eth + 1) > data_end)
        return XDP_PASS;

    if (eth->h_proto != bpf_htons(ETH_P_IP))
        return XDP_PASS;

    struct iphdr *ip = (void *)(eth + 1);
    if ((void *)(ip + 1) > data_end)
        return XDP_PASS;

    if (ip->ihl < 5)
        return XDP_PASS;

    __u16 src_port = 0, dst_port = 0;
    void *payload = NULL;

    if (ip->protocol == IPPROTO_TCP) {
        struct tcphdr *tcp = (void *)ip + (ip->ihl * 4);
        if ((void *)(tcp + 1) > data_end)
            return XDP_PASS;
        if (tcp->doff < 5)
            return XDP_PASS;
        src_port = bpf_ntohs(tcp->source);
        dst_port = bpf_ntohs(tcp->dest);
        payload = (void *)tcp + (tcp->doff * 4);
    } else if (ip->protocol == IPPROTO_UDP) {
        struct udphdr *udp = (void *)ip + (ip->ihl * 4);
        if ((void *)(udp + 1) > data_end)
            return XDP_PASS;
        src_port = bpf_ntohs(udp->source);
        dst_port = bpf_ntohs(udp->dest);
        payload = (void *)(udp + 1);
    } else {
        return XDP_PASS;
    }

    /* Target clearinghouse port ranges: 9800-9900 (CNS/Novation settlement feeds) */
    if ((dst_port < 9800 || dst_port > 9900) && (src_port < 9800 || src_port > 9900))
        return XDP_PASS;

    if (payload >= data_end)
        return XDP_PASS;

    __u32 raw_len = (__u32)(data_end - payload);

    struct packet_mirror_t *pkt = bpf_ringbuf_reserve(&xdp_mirror_ringbuf, sizeof(struct packet_mirror_t), 0);
    if (!pkt)
        return XDP_PASS;

    pkt->timestamp_ns     = bpf_ktime_get_ns();
    pkt->ingress_ifindex  = ctx->ingress_ifindex;
    pkt->packet_len       = raw_len;
    pkt->src_ip           = ip->saddr;
    pkt->dst_ip           = ip->daddr;
    pkt->src_port         = src_port;
    pkt->dst_port         = dst_port;
    pkt->protocol         = ip->protocol;

#if defined(__clang__)
    #pragma unroll
#elif defined(__GNUC__)
    #pragma GCC unroll 512
#endif
    for (int i = 0; i < MAX_PACKET_SLICE; i++) {
        if ((payload + i + 1) <= data_end) {
            pkt->data[i] = *((__u8 *)(payload + i));
        } else {
            break;
        }
    }

    bpf_ringbuf_submit(pkt, 0);
    return XDP_PASS;
}
