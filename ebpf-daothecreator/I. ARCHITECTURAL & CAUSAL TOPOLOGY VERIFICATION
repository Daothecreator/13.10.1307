/* SPDX-License-Identifier: GPL-2.0 *//*
 * financial_ssl_uprobe.bpf.c — Financial Messaging Pre-TLS Interception Engine
 * Implements low-overhead extraction for FIX, SWIFT, and proprietary settlement protocols.
 */#include "vmlinux.h"#include <bpf/bpf_helpers.h>#include <bpf/bpf_tracing.h>#include <bpf/bpf_core_read.h>#include <bpf/bpf_endian.h>#define MAX_FIN_PAYLOAD 4096#define MAX_ENTRIES     65536char LICENSE[] SEC("license") = "GPL";enum fin_proto_t {
    PROTO_UNKNOWN = 0,
    PROTO_FIX     = 1,
    PROTO_SWIFT_MT = 2,
    PROTO_ISO20022 = 3
};struct fin_event_t {
    __u64 timestamp_ns;
    __u64 realtime_ns;
    __u32 pid;
    __u32 tid;
    __u32 uid;
    __u32 payload_len;
    __u32 protocol;       /* enum fin_proto_t */
    __u8  direction;      /* 0 = Outbound (SSL_write), 1 = Inbound (SSL_read) */
    __u8  comm[16];
    __u8  payload[MAX_FIN_PAYLOAD];
};struct {
    __uint(type, BPF_MAP_TYPE_RINGBUF);
    __uint(max_entries, 32 * 1024 * 1024); /* 32MB High-Frequency Ring Buffer */
} fin_ringbuf SEC(".maps");/* Map tracking active SSL_read invocations across thread contexts */struct {
    __uint(type, BPF_MAP_TYPE_HASH);
    __uint(max_entries, MAX_ENTRIES);
    __type(key, __u64);   /* tgid_pid */
    __type(value, void *); /* buffer address */
} active_read_buffers SEC(".maps");static __always_inline enum fin_proto_t identify_protocol(const __u8 *buf, __u32 len) {
    if (len < 10)
        return PROTO_UNKNOWN;

    /* FIX Protocol Detection: "8=FIX." */
    if (buf[0] == '8' && buf[1] == '=' && buf[2] == 'F' && buf[3] == 'I' && buf[4] == 'X' && buf[5] == '.')
        return PROTO_FIX;

    /* SWIFT Basic Header Block: "{1:F01" or "{1:A01" */
    if (buf[0] == '{' && buf[1] == '1' && buf[2] == ':')
        return PROTO_SWIFT_MT;

    /* ISO 20022 XML Envelope Header: "<?xml" or "<Document" / "pacs." / "camt." */
    if ((buf[0] == '<' && buf[1] == '?' && buf[2] == 'x' && buf[3] == 'm' && buf[4] == 'l') ||
        (buf[0] == '<' && buf[1] == 'D' && buf[2] == 'o' && buf[3] == 'c' && buf[4] == 'u'))
        return PROTO_ISO20022;

    return PROTO_UNKNOWN;
}/* --- Outbound SSL_write Uprobe --- */
SEC("uprobe/SSL_write")int BPF_UPROBE(ssl_write_entry, void *ssl, const void *buf, int num) {
    if (num <= 0 || !buf)
        return 0;

    __u32 len = (__u32)num;
    __u8 sample[16];
    if (bpf_probe_read_user(&sample, sizeof(sample), buf) != 0)
        return 0;

    enum fin_proto_t proto = identify_protocol(sample, len);
    if (proto == PROTO_UNKNOWN)
        return 0;

    struct fin_event_t *event = bpf_ringbuf_reserve(&fin_ringbuf, sizeof(struct fin_event_t), 0);
    if (!event)
        return 0;

    __u64 pid_tgid = bpf_get_current_pid_tgid();
    event->timestamp_ns = bpf_ktime_get_ns();
    event->realtime_ns  = bpf_ktime_get_boot_ns();
    event->pid          = pid_tgid >> 32;
    event->tid          = (__u32)pid_tgid;
    event->uid          = bpf_get_current_uid_gid() >> 32;
    event->direction    = 0;
    event->protocol     = proto;
    event->payload_len  = len > MAX_FIN_PAYLOAD ? MAX_FIN_PAYLOAD : len;
    bpf_get_current_comm(&event->comm, sizeof(event->comm));

    if (bpf_probe_read_user(&event->payload, event->payload_len, buf) != 0) {
        bpf_ringbuf_discard(event, 0);
        return 0;
    }

    bpf_ringbuf_submit(event, 0);
    return 0;
}/* --- Inbound SSL_read Entry & Return Probes --- */
SEC("uprobe/SSL_read")int BPF_UPROBE(ssl_read_entry, void *ssl, void *buf, int num) {
    __u64 pid_tgid = bpf_get_current_pid_tgid();
    bpf_map_update_elem(&active_read_buffers, &pid_tgid, &buf, BPF_ANY);
    return 0;
}

SEC("uretprobe/SSL_read")int BPF_URETPROBE(ssl_read_return, int ret) {
    __u64 pid_tgid = bpf_get_current_pid_tgid();
    void **buf_ptr = bpf_map_lookup_elem(&active_read_buffers, &pid_tgid);
    if (!buf_ptr)
        return 0;

    void *buf = *buf_ptr;
    bpf_map_delete_elem(&active_read_buffers, &pid_tgid);

    if (ret <= 0 || !buf)
        return 0;

    __u32 len = (__u32)ret;
    __u8 sample[16];
    if (bpf_probe_read_user(&sample, sizeof(sample), buf) != 0)
        return 0;

    enum fin_proto_t proto = identify_protocol(sample, len);
    if (proto == PROTO_UNKNOWN)
        return 0;

    struct fin_event_t *event = bpf_ringbuf_reserve(&fin_ringbuf, sizeof(struct fin_event_t), 0);
    if (!event)
        return 0;

    event->timestamp_ns = bpf_ktime_get_ns();
    event->realtime_ns  = bpf_ktime_get_boot_ns();
    event->pid          = pid_tgid >> 32;
    event->tid          = (__u32)pid_tgid;
    event->uid          = bpf_get_current_uid_gid() >> 32;
    event->direction    = 1;
    event->protocol     = proto;
    event->payload_len  = len > MAX_FIN_PAYLOAD ? MAX_FIN_PAYLOAD : len;
    bpf_get_current_comm(&event->comm, sizeof(event->comm));

