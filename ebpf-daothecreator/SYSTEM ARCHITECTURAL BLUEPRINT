### 4.2. Inbound DMARC XML Parser Lambda (`dmarc_parser.py`)

```python
import email
import gzip
import io
import json
import os
import urllib.parse
import xml.etree.ElementTree as ET
import zipfile
import boto3

s3 = boto3.client('s3')
PARSED_BUCKET = os.environ.get('PARSED_BUCKET', 'agency-dmarc-reports-parsed')

def decompress_payload(filename, payload_bytes):
    if filename.endswith(('.gz', '.gzip')):
        with gzip.GzipFile(fileobj=io.BytesIO(payload_bytes)) as gz:
            return gz.read()
    elif filename.endswith('.zip'):
        with zipfile.ZipFile(io.BytesIO(payload_bytes)) as zf:
            xmls = [f for f in zf.namelist() if f.endswith('.xml')]
            if xmls:
                return zf.read(xmls[0])
    return payload_bytes

def parse_dmarc_xml(xml_bytes):
    root = ET.fromstring(xml_bytes)
    report_meta = root.find('report_metadata')
    date_range = report_meta.find('date_range') if report_meta is not None else None
    
    records = []
    for record in root.findall('record'):
        row = record.find('row')
        eval_policy = row.find('policy_evaluated') if row is not None else None
        records.append({
            "source_ip": row.findtext('source_ip') if row is not None else None,
            "count": int(row.findtext('count', '0')) if row is not None else 0,
            "disposition": eval_policy.findtext('disposition') if eval_policy is not None else 'none',
            "dkim_alignment": eval_policy.findtext('dkim') if eval_policy is not None else 'fail',
            "spf_alignment": eval_policy.findtext('spf') if eval_policy is not None else 'fail'
        })

    return {
        "report_id": report_meta.findtext('report_id', 'Unknown') if report_meta is not None else 'Unknown',
        "org_name": report_meta.findtext('org_name', 'Unknown') if report_meta is not None else 'Unknown',
        "begin_timestamp": int(date_range.findtext('begin', '0')) if date_range is not None else 0,
        "end_timestamp": int(date_range.findtext('end', '0')) if date_range is not None else 0,
        "record_count": len(records),
        "records": records
    }

def lambda_handler(event, context):
    for record in event.get('Records', []):
        bucket = record['s3']['bucket']['name']
        key = urllib.parse.unquote_plus(record['s3']['object']['key'])
        raw_email = s3.get_object(Bucket=bucket, Key=key)['Body'].read()
        msg = email.message_from_bytes(raw_email)

        for part in msg.walk():
            filename = part.get_filename()
            if filename and any(filename.lower().endswith(ext) for ext in ['.xml', '.gz', '.zip']):
                xml_data = decompress_payload(filename.lower(), part.get_payload(decode=True))
                parsed = parse_dmarc_xml(xml_data)
                out_key = f"parsed_reports/{parsed['org_name']}_{parsed['report_id']}.json"
                s3.put_object(
                    Bucket=PARSED_BUCKET,
                    Key=out_key,
                    Body=json.dumps(parsed, indent=2),
                    ContentType='application/json'
                )
    return {"statusCode": 200}

