    payload: Vec<u8>,
}

struct ZteContainer {
    header: ZteHeader,
    events: Vec<EventRecord>,
    merkle_root: [u8; 32],
}

impl ZteContainer {
    fn new(node_hash: [u8; 32]) -> Self {
        let now = SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_nanos() as u64;
        let mut header = ZteHeader {
            magic: *ZTE_MAGIC,
            version: 2,
            created_ns: now,
            capture_node_hash: node_hash,
            event_count: 0,
            header_hash: [0u8; 12],
        };
        let header_bytes = bincode::serialize(&header).unwrap_or_default();
        let mut hasher = Blake2b512::new();
        hasher.update(&header_bytes);
        header.header_hash.copy_from_slice(&hasher.finalize()[..12]);

        Self { header, events: Vec::new(), merkle_root: [0u8; 32] }
    }

    fn push(&mut self, ke: &KernelEvent) {
        let payload_len = (ke.payload_len as usize).min(MAX_PAYLOAD);
        let actual_payload = &ke.payload[..payload_len];
        
        let mut sha = Sha256::new();
        sha.update(actual_payload);
        let payload_hash: [u8; 32] = sha.finalize().into();

        self.events.push(EventRecord {
            ts_ns: ke.ts_ns,
            realtime_ns: ke.realtime_ns,
            pid: ke.pid,
            uid: ke.uid,
            src_ip: ke.src_ip,
            dst_ip: ke.dst_ip,
            src_port: ke.src_port,
            dst_port: ke.dst_port,
            payload_len: ke.payload_len,
            cpu_id: ke.cpu_id,
            comm: ke.comm,
            payload_hash,
            payload: actual_payload.to_vec(),
        });
        self.header.event_count = self.events.len() as u64;
    }

    fn finalize(&mut self) {
        let mut leaves: Vec<[u8; 32]> = self.events.iter().map(|e| {
            let mut h = Sha256::new();
            h.update(&bincode::serialize(e).unwrap_or_default());
            h.finalize().into()
        }).collect();

        if leaves.is_empty() {
            self.merkle_root = [0u8; 32];
            return;
        }

        while leaves.len() > 1 {
            let mut next = Vec::new();
            for i in (0..leaves.len()).step_by(2) {
                let left = leaves[i];
                let right = if i + 1 < leaves.len() { leaves[i + 1] } else { left };
                let mut h = Sha256::new();
                h.update(&left);
                h.update(&right);
                next.push(h.finalize().into());
            }
            leaves = next;
        }
        self.merkle_root = leaves[0];
    }

    fn to_bytes(&self) -> Result<Vec<u8>> {
        let mut buf = Vec::new();
        buf.extend_from_slice(&bincode::serialize(&self.header)?);
        for ev in &self.events {
            let b = bincode::serialize(ev)?;
            buf.extend_from_slice(&(b.len() as u64).to_le_bytes());
            buf.extend_from_slice(&b);
        }
        buf.extend_from_slice(&self.merkle_root);
        Ok(buf)
    }
}

