/* User-space OpenSSL Entry Uprobe */
SEC("uprobe/SSL_write")
int BPF_UPROBE(ssl_write_entry, void *ssl, const void *buf, int num)
{
    if (num <= 0)
        return 0;

    __u32 len = (__u32)num;
    if (!match_target_signatures(buf, len))
        return 0;

    struct event *e = bpf_ringbuf_reserve(&rb, sizeof(struct event), 0);
    if (!e)
        return 0;

    e->ts_ns = bpf_ktime_get_ns();
    e->realtime_ns = bpf_ktime_get_boot_ns();
    e->pid = bpf_get_current_pid_tgid() >> 32;
    e->uid = bpf_get_current_uid_gid() >> 32;
    e->payload_len = len > MAX_PAYLOAD ? MAX_PAYLOAD : len;
    e->cpu_id = bpf_get_smp_processor_id();
    bpf_get_current_comm(&e->comm, sizeof(e->comm));
    e->src_ip = 0;
    e->dst_ip = 0;
    e->src_port = 0;
    e->dst_port = 0;

    if (bpf_probe_read_user(&e->payload, e->payload_len, buf) != 0) {
        bpf_ringbuf_discard(e, 0);
        return 0;
    }

    bpf_ringbuf_submit(e, 0);
    return 0;
}

/* Kernel TCP Socket Transport Probe */
SEC("kprobe/tcp_sendmsg")
int BPF_KPROBE(tcp_sendmsg_entry, struct sock *sk, struct msghdr *msg, size_t size)
{
    if (size < 12)
        return 0;

    struct iov_iter *iter = &msg->msg_iter;
    if (BPF_CORE_READ(iter, iter_type) != 0)
        return 0;

    struct iovec *iov = (struct iovec *)BPF_CORE_READ(iter, iov);
    if (!iov)
        return 0;

    void *buf = (void *)BPF_CORE_READ(iov, iov_base);
    if (!buf || !match_target_signatures(buf, (__u32)size))
        return 0;

    struct event *e = bpf_ringbuf_reserve(&rb, sizeof(struct event), 0);
    if (!e)
        return 0;

    e->ts_ns = bpf_ktime_get_ns();
    e->realtime_ns = bpf_ktime_get_boot_ns();
    e->pid = bpf_get_current_pid_tgid() >> 32;
