    struct inet_sock *inet = (struct inet_sock *)sk;
    e->src_ip = BPF_CORE_READ(inet, inet_saddr);
    e->dst_ip = BPF_CORE_READ(inet, inet_daddr);
    e->src_port = bpf_ntohs(BPF_CORE_READ(inet, inet_sport));
