    inputs:
      Runtime: python3.11
      Handler: script_handler
      Script: |
        def script_handler(events, context):
            ticket = events.get('ticket', '')
            if not ticket or len(ticket) < 5:
                raise Exception("Validation Error: A valid ITSM ticket reference (e.g. INC-XXXXX) is required.")
            return {"status": "VALIDATED", "ticket": ticket}
