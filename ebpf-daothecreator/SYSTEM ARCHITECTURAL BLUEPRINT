### 6.3. Bounded Environment Auto-Remediation Engine (`.github/workflows/auto-remediate.yml`)

```yaml
name: "Automated IaC Drift Auto-Remediation"

on:
  schedule:
    - cron: "30 2 * * *"
  workflow_dispatch:
    inputs:
      environment:
        description: "Target Environment"
        required: true
        default: "development"

permissions:
  id-token: write
  contents: read
  issues: write

jobs:
  auto_remediate:
    name: "Detect & Overwrite Drift"
    runs-on: ubuntu-latest
    environment: ${{ github.event.inputs.environment || 'development' }}

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Configure AWS Credentials via OIDC
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ secrets.AWS_ROLE_ARN }}
          aws-region: ${{ secrets.AWS_REGION }}
          audience: sts.amazonaws.com

      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: "1.9.0"

      - name: Terraform Init
        run: terraform init

      - name: Check for Drift
        id: drift_check
        run: |
          set +e
          terraform plan -detailed-exitcode -no-color -out=remediate.tfplan > drift_output.txt
          EXIT_CODE=$?
          echo "exit_code=${EXIT_CODE}" >> $GITHUB_OUTPUT
          set -e

      - name: Apply Auto-Remediation State
        if: steps.drift_check.outputs.exit_code == '2' && vars.AUTO_REMEDIATE_ENABLED == 'true'
        run: terraform apply -auto-approve remediate.tfplan

      - name: Post Remediation Webhook Alert
        if: steps.drift_check.outputs.exit_code == '2' && vars.AUTO_REMEDIATE_ENABLED == 'true'
        run: |
          curl -X POST "${{ secrets.WEBHOOK_URL }}" \
            -H "Content-Type: application/json" \
            -d '{"text":"🔧 *IaC Auto-Remediation Executed:* Unapproved drift was automatically overwritten."}'

