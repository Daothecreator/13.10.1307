        data=json.dumps(payload).encode('utf-8'),
        headers={'Content-Type': 'application/json', 'X-API-Key': creds.get('API_KEY', '')}
    )
    with urllib.request.urlopen(req) as response:
        return {'statusCode': 200, 'body': 'Delivered'}

