### 4.1. Lambda Quarantine Diagnostician (`diagnostician.py`)

```python
import json
import os
import urllib.parse
from datetime import datetime, timezone
import boto3

s3 = boto3.client('s3')
sns = boto3.client('sns')
dynamodb = boto3.resource('dynamodb')

SNS_TOPIC_ARN = os.environ.get('SNS_TOPIC_ARN')
TABLE_NAME = os.environ.get('DYNAMODB_TABLE_NAME', 'ForensicQuarantineDiagnostics')
table = dynamodb.Table(TABLE_NAME)

def run_diagnostics(content, filename):
    diag = {
        "filename": filename,
        "is_valid_json": False,
        "total_events": 0,
        "events_missing_hash": 0,
        "events_invalid_timestamp_type": 0,
        "schema_errors": [],
        "root_cause_summary": ""
    }
    try:
        data = json.loads(content.decode('utf-8'))
        diag["is_valid_json"] = True
    except UnicodeDecodeError:
        diag["schema_errors"].append("Binary corruption or invalid UTF-8 encoding.")
        diag["root_cause_summary"] = "Non UTF-8 character encoding."
        return diag
    except json.JSONDecodeError as e:
        diag["schema_errors"].append(f"Malformed JSON syntax at line {e.lineno}: {e.msg}")
        diag["root_cause_summary"] = "Truncated JSON payload."
        return diag

    events = data.get("events")
    if not isinstance(events, list):
        diag["schema_errors"].append("Missing or non-array 'events' field.")
        diag["root_cause_summary"] = "Root schema mismatch."
        return diag

    diag["total_events"] = len(events)
    for idx, ev in enumerate(events):
        if not isinstance(ev, dict):
            continue
        if not ev.get("payload_hash"):
            diag["events_missing_hash"] += 1
        ts = ev.get("timestamp_ns")
        if ts is not None and not isinstance(ts, int):
            diag["events_invalid_timestamp_type"] += 1
            diag["schema_errors"].append(f"Row {idx}: timestamp_ns is float ({type(ts).__name__}), expected int.")

    if diag["events_invalid_timestamp_type"] > 0:
        diag["root_cause_summary"] = "Float precision truncation detected on timestamp_ns (violates RFC 8785)."
    elif diag["events_missing_hash"] > 0:
        diag["root_cause_summary"] = f"{diag['events_missing_hash']} events missing required payload_hash."
    elif not diag["schema_errors"]:
        diag["root_cause_summary"] = "Schema valid; quarantine caused by missing bundle or EVM mismatch."
    else:
        diag["root_cause_summary"] = "Multiple row-level schema anomalies."

    return diag

def lambda_handler(event, context):
    for record in event.get('Records', []):
        bucket = record['s3']['bucket']['name']
        key = urllib.parse.unquote_plus(record['s3']['object']['key'])
        filename = os.path.basename(key)

        res = s3.get_object(Bucket=bucket, Key=key)
        diag = run_diagnostics(res['Body'].read(), filename)

        # Log item to DynamoDB
        table.put_item(Item={
            "filename": filename,
            "quarantine_timestamp": datetime.now(timezone.utc).isoformat(),
            "s3_bucket": bucket,
            "s3_key": key,
            "is_valid_json": diag["is_valid_json"],
            "total_events": diag["total_events"],
            "root_cause_summary": diag["root_cause_summary"],
            "error_count": len(diag["schema_errors"])
        })

        if SNS_TOPIC_ARN:
            sns.publish(
                TopicArn=SNS_TOPIC_ARN,
                Subject=f"[DIAGNOSTIC CRITICAL] Quarantined File: {filename}",
                Message=f"Quarantined File: {filename}\nBucket: s3://{bucket}/{key}\nRoot Cause: {diag['root_cause_summary']}"
            )
    return {"statusCode": 200}

